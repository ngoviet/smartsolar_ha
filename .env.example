# Mẫu — chép thành .env rồi điền giá trị thật (.env đã gitignore). Tự sinh từ .env hiện có (chỉ giữ tên biến).
HA_TOKEN=
HA_PASS=
HA_HOST=
HA_URL=

# SmartSolar cloud credentials — verify_live.py uses these to learn which
# devices report a WiFi signal (optional; without them that check is skipped).
SMARTSOLAR_USER=
SMARTSOLAR_PASS=
